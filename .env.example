# -----------------------------------------------------------------------------
# Faro School - Environment Configuration
# -----------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_NAME="Faro School"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Kobara Unified Payment Gateway (MonCash & NatCash in Haiti)
# Documentation: https://docs.kobara.app/docs/quickstart
# Leave KOBARA_SECRET_KEY empty to run in automatic MOCK mode during development
KOBARA_API_URL="https://api.kobara.app"
KOBARA_SECRET_KEY=""
KOBARA_PUBLIC_KEY=""
KOBARA_WEBHOOK_SECRET=""

# Bunny Stream (Course Video Protection & Signed Playback)
# Leave empty to automatically fallback to MockVideoProvider
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_TOKEN_AUTH_KEY=""
BUNNY_STREAM_HOSTNAME="video.faroschool.com"

# Bunny Storage + CDN (Images & Enrolled Downloadables)
BUNNY_STORAGE_ZONE_NAME="faro-storage"
BUNNY_STORAGE_API_KEY=""
BUNNY_STORAGE_CDN_HOSTNAME="cdn.faroschool.com"
BUNNY_STORAGE_TOKEN_KEY="your-bunny-storage-token-key"

# Support & Contact (WhatsApp & Email)
NEXT_PUBLIC_SUPPORT_EMAIL="contact@faroschool.com"
NEXT_PUBLIC_SUPPORT_PHONE="+50936000000"
NEXT_PUBLIC_COMPANY_ADDRESS="Port-au-Prince, Haïti"
