# -----------------------------------------------------------------------------
# Faro School - Environment Configuration (.env.example)
# Copy this file to .env.local for local development.
# In production, inject server secrets via Cloudflare Wrangler secrets.
# -----------------------------------------------------------------------------

# Application Environment ('production', 'staging', 'development')
APP_ENV="development"
NEXT_PUBLIC_APP_NAME="Faro School"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="HTG"

# Supabase (Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only: privileged operations (system credentials, admin jobs)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Supabase JWT Secret (found in Supabase Settings -> API -> JWT Secret)
# Used by Faro to sign short-lived tokens so PostgREST RLS and Realtime authenticate Auth.js users
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-min-32-chars"

# Auth.js v5 (NextAuth) Session Configuration
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"

# Resend (Email Verification, Password Reset & Invitations)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Faro School <noreply@faroschool.com>"
# Resend dashboard -> Webhooks -> signing secret (server only)
RESEND_WEBHOOK_SECRET=""

# Kobara Payment Gateway (MonCash & NatCash in Haiti)
# In production, KOBARA_MODE must be 'live'
KOBARA_MODE="test"
KOBARA_BASE_URL="https://api.kobara.app"
KOBARA_API_KEY="kobara_sk_test_placeholder"
KOBARA_WEBHOOK_SECRET="whsec_test_placeholder"

# Cron & Background Jobs Authorization
CRON_SECRET="your-high-entropy-cron-secret-64-hex"

# Google Gemini (Educational AI Assistant) - Optional (falls back gracefully)
GEMINI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
# Optional legacy fallback:
# ANTHROPIC_API_KEY=""

# Bunny Stream (Video Streaming & DRM HLS Token Authentication)
BUNNY_STREAM_LIBRARY_ID="12345"
BUNNY_STREAM_API_KEY="your-bunny-stream-api-key"
# Library Read-Only API key: also signs Bunny Stream webhooks (not the token auth key)
BUNNY_STREAM_READ_ONLY_API_KEY=""
BUNNY_STREAM_TOKEN_AUTH_KEY="your-bunny-stream-token-auth-key"
BUNNY_STREAM_HOSTNAME="video.faroschool.com"

# Bunny Storage + CDN (Images & Enrolled Student Resources)
BUNNY_STORAGE_ZONE_NAME="faro-storage"
BUNNY_STORAGE_API_KEY="your-bunny-storage-api-key"
BUNNY_STORAGE_CDN_HOSTNAME="cdn.faroschool.com"
BUNNY_STORAGE_TOKEN_KEY="your-bunny-storage-token-key"

# Support & Contact Information
NEXT_PUBLIC_SUPPORT_EMAIL="contact@faroschool.com"
NEXT_PUBLIC_SUPPORT_PHONE="+509 36 00 00 00"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+509 36 00 00 00"
NEXT_PUBLIC_COMPANY_ADDRESS="Port-au-Prince, Haïti"

INSTRUCTOR_ESCALATION_EMAIL=
