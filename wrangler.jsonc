{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faro-school",
  "main": "custom-worker.mjs",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "keep_vars": true,
  "triggers": {
    "crons": ["* * * * *"]
  }
}
